{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Build-n-QA Test Results",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "gdd_revision": {
      "type": "string",
      "minLength": 1
    },
    "emulator_id": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "Test Result",
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "observed": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bug_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocker": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "test_id",
          "status",
          "observed",
          "evidence_refs",
          "bug_ids"
        ]
      }
    }
  },
  "required": [
    "task_id",
    "run_id",
    "build_id",
    "gdd_revision",
    "emulator_id",
    "results"
  ]
}
